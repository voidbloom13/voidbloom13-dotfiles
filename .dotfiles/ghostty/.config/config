background-image = "~/voidbloom13-dotfiles/assets/terminal-wallpaper.png"
background-image-fit = "cover"
maximize = true
background = 000000
foreground = c8c8c8
background-image-opacity = 0.2
background-opacity = 1
background-blur = true
cursor-style = block
cursor-color = 0088ff
cursor-style-blink = true
shell-integration-features = no-cursor
title = "Ghostty"
theme = "Catppuccin Mocha"
window-padding-x = 0
window-padding-y = 0
window-theme = ghostty
window-titlebar-background = 202020

font-family = "FiraCode Nerd Font"
font-family-bold = "FiraCode Nerd Font"
font-family-italic = "VictorMono Nerd Font"
font-family-bold-italic = "VictorMono Nerd Font"
font-feature = "+calt, +liga, +dlig"
